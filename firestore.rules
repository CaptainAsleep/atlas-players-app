rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Single hardcoded admin uid — same pattern as ATLAS_OWNER_UID in the
    // player app's own code, just enforced at the rules layer too.
    // Declared here at the top (rather than down by owners/{ownerId},
    // where it used to live) since more than one match block now needs it
    // — fields/{fieldId}/private/{docId} (shipping addresses) included.
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'lg4HMLTJvsPfSEN1pvNhMV4fbct1';
    }

    // ── Owner-built field patches + team patch libraries (2026-10-27) ────
    // Libraries live at fields/{fieldId}/fieldPatches and
    // teams/{teamId}/teamPatches — deliberately NOT named "patches", which is
    // reserved for users/{uid}/patches (see the {path=**}/patches
    // collection-group rule below and the admin portal's count of it).
    function isFieldOwnerOf(fieldId) {
      return request.auth != null
        && get(/databases/$(database)/documents/fields/$(fieldId)).data.get('ownerId', null) == request.auth.uid;
    }

    function isTeamOfficerOf(teamId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == "officer";
    }

    // ── Field Staff Logins (2026-10-27) ──────────────────────────────────
    // A field owner's staff (fields/{fieldId}/staff/{uid}, created only by
    // the acceptStaffInvites Cloud Function) can check players in — nothing
    // else. A grant only counts once that staff member has accepted the
    // staff agreement (agreementVersion set). Staff access to check-in data
    // (child attendee details, waiver signatures, the check-in write itself)
    // is further locked to a window around the event's own date: from UTC
    // midnight OF the event date until UTC midnight two days after its last
    // day. Every US zone is behind UTC, so in local time that's the evening
    // before the event (8pm Eastern / 5pm Pacific) until the evening after
    // it ends — no field time zone needed in the rules. Per Michael:
    // "within a day of the event.
    // functions/staff.js staffWindowOpen() is the same math for
    // checkInByCode; keep the two in sync by hand.
    function isFieldStaffOf(fieldId) {
      return request.auth != null
        && fieldId is string
        && exists(/databases/$(database)/documents/fields/$(fieldId)/staff/$(request.auth.uid))
        && get(/databases/$(database)/documents/fields/$(fieldId)/staff/$(request.auth.uid)).data.get('agreementVersion', null) != null;
    }

    function staffDayStart(s) {
      return timestamp.date(int(s[0:4]), int(s[5:7]), int(s[8:10]));
    }

    function staffWindowOpen(eventId) {
      let ev = get(/databases/$(database)/documents/events/$(eventId)).data;
      let start = ev.get('date', '');
      let endRaw = ev.get('endDate', '');
      let end = (endRaw is string && endRaw.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')) ? endRaw : start;
      return start is string
        && start.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.time >= staffDayStart(start)
        && request.time < staffDayStart(end) + duration.value(2, 'd');
    }

    function canStaffCheckIn(fieldId, eventId) {
      return isFieldStaffOf(fieldId) && staffWindowOpen(eventId);
    }

    function validPatchArt(d) {
      return d.name is string && d.name.size() >= 1 && d.name.size() <= 40
        && d.imageUrl is string && d.imageUrl.matches('https://firebasestorage[.]googleapis[.]com/.*')
        && (d.get('details', null) == null || (d.details is string && d.details.size() <= 200));
    }

    // One owner rule template (see FIELD_RULE_TYPES in achievementEngine.js).
    // The field id is never stored on the rule — the engine forces it from
    // the path — so an owner can only ever write rules about their own field.
    function validFieldRule(r) {
      return r is map
        && r.keys().hasOnly(['type', 'count', 'eventType', 'hour', 'keywords', 'start', 'end'])
        && r.type in ['checkins', 'event_streak', 'weekend_streak', 'event_type', 'night', 'keywords', 'date_range']
        && r.count is int && r.count >= 1 && r.count <= 100
        && (r.get('eventType', '') is string)
        && (r.get('hour', 20) is int && r.get('hour', 20) >= 0 && r.get('hour', 20) <= 23)
        && (r.get('keywords', []) is list && r.get('keywords', []).size() <= 5)
        && (r.get('start', '') is string && r.get('end', '') is string);
    }

    function validFieldPatch(d) {
      return d.keys().hasOnly(['name', 'imageUrl', 'details', 'rules', 'active', 'grantDocId', 'migratedFromCatalogId', 'createdBy', 'createdAt', 'updatedAt'])
        && validPatchArt(d)
        && d.rules is list && d.rules.size() <= 2
        && (d.rules.size() < 1 || validFieldRule(d.rules[0]))
        && (d.rules.size() < 2 || validFieldRule(d.rules[1]))
        && d.active is bool;
    }

    // A field owner handing one of their field's patches to a player who has
    // a checked-in booking at that field. Rules can't search for "any
    // check-in here", so the client names one (proofEventId) and this checks
    // it. The granted copy must match the library entry exactly and land at
    // its grantDocId — so an owner can't mint anything that isn't theirs.
    function fieldOwnerGrant(userId, patchId) {
      let d = request.resource.data;
      let lib = get(/databases/$(database)/documents/fields/$(d.fieldId)/fieldPatches/$(d.fieldPatchId)).data;
      return d.keys().hasOnly(['name', 'imageUrl', 'details', 'addedAt', 'granted', 'seen', 'fieldId', 'fieldPatchId', 'grantedBy', 'proofEventId'])
        && d.grantedBy == request.auth.uid
        && d.granted == true && d.seen == false && d.addedAt == request.time
        && isFieldOwnerOf(d.fieldId)
        && lib.grantDocId == patchId && lib.name == d.name && lib.imageUrl == d.imageUrl
        && lib.get('active', true) == true
        && get(/databases/$(database)/documents/events/$(d.proofEventId)).data.fieldId == d.fieldId
        && get(/databases/$(database)/documents/events/$(d.proofEventId)/bookings/$(userId)).data.get('checkedIn', false) == true;
    }

    // A team officer handing one of the team library's patches to a current
    // member of that team (Team Patches, 2026-10-27). Same exact-match idea.
    function teamOfficerGrant(userId, patchId) {
      let d = request.resource.data;
      let lib = get(/databases/$(database)/documents/teams/$(d.teamId)/teamPatches/$(d.teamPatchId)).data;
      return d.keys().hasOnly(['name', 'imageUrl', 'details', 'addedAt', 'granted', 'seen', 'teamId', 'teamPatchId', 'grantedBy'])
        && d.grantedBy == request.auth.uid
        && d.granted == true && d.seen == false && d.addedAt == request.time
        && isTeamOfficerOf(d.teamId)
        && exists(/databases/$(database)/documents/teams/$(d.teamId)/members/$(userId))
        && lib.grantDocId == patchId && lib.name == d.name && lib.imageUrl == d.imageUrl;
    }

    // Child Patches (2026-10-27): the same field-owner grant, but into a
    // child profile's childPatches. Proof is the PARENT's checked-in booking
    // at that field with this child on it (attendeeDetails/{depId} only
    // exists when the child was on the booking). Same exact-match pinning.
    // A graduated (handed-over) child profile takes no new patches.
    function fieldOwnerChildGrant(userId, depId, patchId) {
      let d = request.resource.data;
      let lib = get(/databases/$(database)/documents/fields/$(d.fieldId)/fieldPatches/$(d.fieldPatchId)).data;
      return d.keys().hasOnly(['name', 'imageUrl', 'details', 'addedAt', 'granted', 'seen', 'fieldId', 'fieldPatchId', 'grantedBy', 'proofEventId'])
        && d.grantedBy == request.auth.uid
        && d.granted == true && d.seen == false && d.addedAt == request.time
        && isFieldOwnerOf(d.fieldId)
        && lib.grantDocId == patchId && lib.name == d.name && lib.imageUrl == d.imageUrl
        && lib.get('active', true) == true
        && get(/databases/$(database)/documents/events/$(d.proofEventId)).data.fieldId == d.fieldId
        && get(/databases/$(database)/documents/events/$(d.proofEventId)/bookings/$(userId)).data.get('checkedIn', false) == true
        && exists(/databases/$(database)/documents/events/$(d.proofEventId)/bookings/$(userId)/attendeeDetails/$(depId))
        && get(/databases/$(database)/documents/users/$(userId)/dependents/$(depId)).data.get('graduatedAt', null) == null;
    }

    // No field-count cap anymore — Atlas Standard has no subscription
    // tiers to key one off of, so any owner can claim unlimited fields
    // (removed 2026-09 along with tierFieldCap/ownerCanClaimAnotherField).

    // The admin-defined achievement catalog — public read (so the app can
    // check and display them), but no client write at all. These are
    // entered only via the seed script, same as fields and DTB — not
    // something any owner or player can create, since they're app-wide
    // achievements, not tied to any single field's owner.
    // Child-profile hand-over tokens (2026-10-27), keyed by sha256 of the
    // emailed token. Cloud Functions only — no client ever reads or writes.
    match /childGraduations/{tokenHash} {
      allow read, write: if false;
    }

    match /achievementPatches/{patchId} {
      allow read: if true;
      allow write: if false;
    }

    match /fields/{fieldId} {
      allow read: if true;
      allow create: if false; // fields are only added via the admin seed script
      // Claiming has three paths. All are written defensively with .get(key,
      // default) rather than plain dot-access — none of our existing field
      // docs have an ownerId/ownerEmailDomain key at all yet, and directly
      // reading a genuinely-missing field errors out the whole rule (which
      // Firestore treats as a silent deny) instead of safely reading as
      // "unset." .get() sidesteps that entirely.
      allow update: if request.auth != null && (
        // Path 1: instant, verified claim — the field has a known owner
        // domain on file (real fields with a real website), and the
        // claiming account's own email matches it exactly. No manual
        // review needed; the domain match IS the verification.
        (resource.data.get('ownerId', null) == null
          && resource.data.get('ownerEmailDomain', null) != null
          && request.auth.token.get('email', '').split('@')[1] == resource.data.get('ownerEmailDomain', null)
          // Security fix 2026-10-13: the domain match alone proved nothing —
          // email/password sign-up never confirms the inbox, so anyone could
          // register name@<field's domain> and take the listing. The token's
          // email_verified claim is only true once the inbox clicked a
          // verification link (or the provider vouches for it, e.g. Google).
          && request.auth.token.get('email_verified', false) == true
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.claimed == true)
        ||
        // Path 2: pending review — no verifiable domain on file (Facebook-
        // only fields, the Atlas Field test fixture), so a claim files a
        // request instead of granting access outright. ownerId/claimed
        // stay untouched here — those only get set via a manual approval
        // in the Firestore console, same pattern used everywhere else
        // without a real admin panel yet. Blocks a second pending request
        // once one already exists, so requests can't pile up unresolved.
        (resource.data.get('ownerId', null) == null
          && resource.data.get('ownerEmailDomain', null) == null
          && resource.data.get('claimPending', false) != true
          && request.resource.data.get('ownerId', null) == null
          && request.resource.data.get('claimed', false) != true
          && request.resource.data.claimPending == true
          && request.resource.data.claimRequestedBy == request.auth.uid)
        ||
        // Path 3: instant, unverified claim — no domain AND no website on
        // file to automatically verify against at all (Facebook-only
        // fields, test fixtures). A bad claim here can only affect
        // listing content, never money — Stripe's own KYC still gates any
        // real payout for the claiming account — so this claims instantly
        // rather than stalling the owner on manual review, flagged
        // claimVerification == 'unverified' so it can still be spot-
        // checked or disputed later. Real website-verification claims
        // (a domain mismatch but a real site to prove ownership of)
        // never come through here at all — those are written server-side
        // by the verifyWebsiteClaim Cloud Function via the Admin SDK,
        // which bypasses these rules entirely after actually confirming
        // the code is live on the site.
        (resource.data.get('ownerId', null) == null
          && resource.data.get('website', null) == null
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.claimed == true
          && request.resource.data.claimVerification == 'unverified')
        ||
        // Editing a field you already own.
        resource.data.get('ownerId', null) == request.auth.uid
        ||
        // Admin (Michael) can always update a field directly — used to
        // approve/reject a pending claim from the admin portal, or to fix any
        // other field data by hand. Same isAdmin() already used for
        // fields/{fieldId}/private/{docId} and owners/{ownerId} reads above.
        isAdmin()
      );
      allow delete: if false;

      // Banned players — private to the field's own owner. Deliberately
      // NOT publicly readable (a ban list is sensitive information about
      // specific players), unlike almost everything else here.
      match /bannedPlayers/{uid} {
        allow read, write: if request.auth != null && get(/databases/$(database)/documents/fields/$(fieldId)).data.get('ownerId', null) == request.auth.uid;
        // Staff (2026-10-27) can SEE the ban list so the roster flags banned
        // players at the gate; only the owner can ban or unban.
        allow read: if isFieldStaffOf(fieldId);
      }

      // Field Staff Logins (2026-10-27). Grants are created only by the
      // acceptStaffInvites Cloud Function (verified email matching a pending
      // invite, 20-per-field cap). The staff member can read their own grant
      // and record their own acceptance of the staff agreement — nothing
      // else (permissions, name, field are server-owned). The field owner
      // can read the list and remove staff (access ends immediately, since
      // every staff rule reads this doc live).
      match /staff/{staffUid} {
        allow read: if request.auth != null && (
          request.auth.uid == staffUid
          || get(/databases/$(database)/documents/fields/$(fieldId)).data.get('ownerId', null) == request.auth.uid
          || isAdmin()
        );
        allow create: if false;
        allow update: if request.auth != null && request.auth.uid == staffUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['agreementVersion', 'agreementAcceptedAt'])
          && request.resource.data.agreementVersion is string
          && request.resource.data.agreementVersion.size() > 0
          && request.resource.data.agreementVersion.size() <= 40
          && request.resource.data.agreementAcceptedAt == request.time;
        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/fields/$(fieldId)).data.get('ownerId', null) == request.auth.uid;
      }

      // Pending staff invites. Written only by the inviteStaff Cloud Function
      // (cap + duplicate checks + the invite email); the owner can see and
      // cancel them. Invites never expire (Michael, 2026-10-27).
      match /staffInvites/{inviteId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/fields/$(fieldId)).data.get('ownerId', null) == request.auth.uid
          || isAdmin()
        );
        allow create, update: if false;
        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/fields/$(fieldId)).data.get('ownerId', null) == request.auth.uid;
      }

      // Private, field-scoped operational data that must never be public,
      // unlike the fields/{fieldId} doc itself (allow read: if true above).
      // Currently just the shipping/mailing address for welcome-package
      // fulfillment (stickers, tablet stand) — collected separately from
      // the field's public address because some fields are unstaffed and
      // that public address isn't where mail should actually go. Owner can
      // read/write their own field's doc here; isAdmin() gets read (to
      // actually ship the package) and write (so Michael can fix a typo
      // without having to ask the owner to redo it).
      // Gifted free-entry ledger (2026-10-24) — giftFreeEntryVoucher counts
      // this for the monthly cap, so owners can read it but never write it
      // (deleting entries would reset the cap). Cloud Functions only.
      match /voucherGifts/{giftId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/fields/$(fieldId)).data.get('ownerId', null) == request.auth.uid
          || isAdmin()
        );
        allow write: if false;
      }

      match /private/{docId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/fields/$(fieldId)).data.get('ownerId', null) == request.auth.uid
          || isAdmin()
        );
        allow write: if request.auth != null && (
          get(/databases/$(database)/documents/fields/$(fieldId)).data.get('ownerId', null) == request.auth.uid
          || isAdmin()
        );
      }

      // Michael's own free-form tracking notes about this field (follow-up
      // calls, claim history, anything worth remembering) — admin-only,
      // deliberately NOT extended to the field's own owner the way
      // private/{docId} above is. Different purpose (Michael's internal
      // notes vs. shared operational data like the shipping address), so
      // a separate, narrower rule rather than reusing that one.
      match /adminNotes/{noteId} {
        allow read, write: if isAdmin();
      }

      // Owner-built unlockable patches (2026-10-27). Public read (players see
      // what a field offers and track progress). The owner creates and edits
      // their own; grantDocId is pinned to a field-namespaced id so a patch
      // can never be aimed at a catalog id like "secret-agent". Only an admin
      // (or the Admin SDK migration script) can create one that reuses a
      // catalog id (migratedFromCatalogId, e.g. DTB). No delete — retiring
      // (active: false) keeps provenance; holders keep their copy either way.
      match /fieldPatches/{patchId} {
        allow read: if true;
        allow create: if isAdmin() || (
          isFieldOwnerOf(fieldId)
          && validFieldPatch(request.resource.data)
          && request.resource.data.grantDocId == 'field-' + fieldId + '-' + patchId
          && request.resource.data.get('migratedFromCatalogId', null) == null
          && request.resource.data.createdBy == request.auth.uid
        );
        allow update: if isAdmin() || (
          isFieldOwnerOf(fieldId)
          && validFieldPatch(request.resource.data)
          && request.resource.data.grantDocId == resource.data.grantDocId
          && request.resource.data.get('migratedFromCatalogId', null) == resource.data.get('migratedFromCatalogId', null)
          && request.resource.data.createdBy == resource.data.createdBy
        );
        allow delete: if isAdmin();
      }
    }
    match /events/{eventId} {
      allow read: if true;
      // Creating a new event requires owning the field it belongs to —
      // checked by reading that field's own ownerId.
      //
      // Atlas Major (2026-10-18): an organizer with no field creates an event
      // carrying isMajor + hostOwnerId == their own uid and NO fieldId, so
      // there is no field for anyone else to be planted onto. The two
      // branches are mutually exclusive on purpose: an ordinary field event
      // may not carry isMajor/hostOwnerId (otherwise a field owner could
      // flip their own event into the uncapped-fee Major path), and a Major
      // may not name a field. Every read of an optional key uses .get() — a
      // bare read of a missing key errors, which denies.
      allow create: if request.auth != null && (
        (request.resource.data.get('isMajor', false) == true
          && request.resource.data.get('hostOwnerId', null) == request.auth.uid
          && request.resource.data.get('fieldId', null) == null
          // Needs an owners/{uid} account (field owner or organizer), so a
          // player-only account can't publish public events straight to
          // Firestore. Payments would already fail without one.
          && exists(/databases/$(database)/documents/owners/$(request.auth.uid)))
        ||
        (request.resource.data.get('isMajor', false) != true
          && request.resource.data.get('hostOwnerId', null) == null
          && get(/databases/$(database)/documents/fields/$(request.resource.data.fieldId)).data.ownerId == request.auth.uid)
      );
      allow delete: if request.auth != null && (
        resource.data.get('hostOwnerId', null) == request.auth.uid
        ||
        (resource.data.get('hostOwnerId', null) == null
          && get(/databases/$(database)/documents/fields/$(resource.data.fieldId)).data.ownerId == request.auth.uid)
      );
      // Security fix 2026-10-13: these counters used to accept ANY value from
      // any signed-in user — enough to fake "capacity reached" on any event,
      // and to email-bomb an owner (notifyOwnerOverCapacity sends one email
      // per increase past the cap). bookedCount is otherwise maintained by
      // Cloud Functions (Admin SDK, not subject to rules); the only client
      // write left is cancelBooking() in the player app's useBookings.js,
      // which must free exactly the seats of the caller's own unpaid booking
      // in the same batch that deletes it.
      function cancelFreesOwnSeats() {
        let bookingPath = /databases/$(database)/documents/events/$(eventId)/bookings/$(request.auth.uid);
        let mirrorPath = /databases/$(database)/documents/users/$(request.auth.uid)/bookings/$(eventId);
        let n = exists(mirrorPath) ? get(mirrorPath).data.get('attendeeCount', 1) : 1;
        let seats = (n is number && n > 1) ? n : 1;
        return exists(bookingPath)
          && get(bookingPath).data.get('paid', false) != true
          && !existsAfter(bookingPath)
          && request.resource.data.bookedCount == resource.data.get('bookedCount', 0) - seats;
      }
      allow update: if request.auth != null && (
        // Favorite toggle (useFavorites.js): interestCount moves by exactly
        // one in either direction, nothing else changes.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["interestCount"])
          && (request.resource.data.interestCount == resource.data.get('interestCount', 0) + 1
              || request.resource.data.interestCount == resource.data.get('interestCount', 0) - 1))
        ||
        // Unpaid-booking cancel (useBookings.js): see cancelFreesOwnSeats.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["bookedCount"])
          && cancelFreesOwnSeats())
        ||
        // The event's own field owner making a full edit — but not moving
        // the event onto a different field (fieldId is part of what decides
        // who owns it; changing it could plant events on someone else's page).
        (resource.data.get('hostOwnerId', null) == null
          && request.resource.data.get('hostOwnerId', null) == null
          && request.resource.data.get('isMajor', false) != true
          && get(/databases/$(database)/documents/fields/$(resource.data.fieldId)).data.ownerId == request.auth.uid
          && request.resource.data.fieldId == resource.data.fieldId)
        ||
        // Atlas Major: the hosting organizer making a full edit. fieldId,
        // hostOwnerId and isMajor are immutable — they decide who owns the
        // event and which fee/payout path it takes, so changing any of them
        // could hand the event (or its payouts) to someone else.
        (resource.data.get('hostOwnerId', null) == request.auth.uid
          && request.resource.data.get('hostOwnerId', null) == resource.data.get('hostOwnerId', null)
          && request.resource.data.get('isMajor', false) == resource.data.get('isMajor', false)
          && request.resource.data.get('fieldId', null) == resource.data.get('fieldId', null))
      );

      // Real bookings — public read, same openness as team rosters, so a
      // "who's going" list is basically free once this exists. Creating one
      // requires being signed in as the exact uid being booked, and — this
      // is the real enforcement, not just a UI nicety — if the event has a
      // waiver, a matching signature must already exist first. A player
      // can't route around this by calling Firestore directly; the rule
      // itself checks for the signature. No update allowed — a booking is
      // either there or it's been deleted (cancelled), nothing in between.
      match /bookings/{uid} {
        allow read: if true;
        // A booking is money-adjacent even when the price is $0 — it's
        // proof of entry, and this used to let any signed-in player
        // write one directly (waiver check aside), with no verification
        // that the event's real price (base + whatever Price Options
        // choice) actually came out to zero. That meant a paid event
        // could be "booked" for free from browser devtools, no Stripe
        // involved at all. Booking creation is Cloud-Function-only now,
        // same trust model as payoutsEnabled/stripeConnectAccountId below —
        // createBookingCheckout's webhook for a real charge,
        // bookFreeEvent for a genuinely free one, both of which resolve
        // the actual price themselves before writing anything.
        allow create: if false;
        // Deletion blocked for a paid booking — this is the real
        // backstop, not just the UI gate in the app. A client-side check
        // alone could be bypassed (devtools, a future bug); this is the
        // one place that can't be, since it's enforced regardless of what
        // code actually calls it.
        allow delete: if request.auth != null && request.auth.uid == uid
          // .get() with a default, not a bare field access — a free
          // booking never had `paid` written at all (bookFreeEvent
          // omits it entirely rather than writing paid: false), and
          // reading a field that doesn't exist via dot notation is a
          // rules-evaluation error here, not a null — which silently
          // denies the whole allow expression. That's what was
          // breaking self-cancel for every free-event booking: the
          // uid/ownership check was fine, this line just errored out
          // before it ever got evaluated.
          && resource.data.get('paid', false) != true;
        // Only the event's own field owner can mark a check-in, and only
        // the checkedIn/checkedInAt fields — narrow, same pattern as the
        // interestCount/bookedCount restriction on events itself. Reads
        // fieldId directly off the booking doc (denormalized at booking
        // time) rather than chaining through the event doc — a single
        // lookup instead of two, consistent with how this schema always
        // prefers denormalization over nested reads.
        // hostOwnerId (Atlas Major) is denormalized onto the booking by the
        // Cloud Function that creates it (client create is blocked above), so
        // it can be trusted here; field-based bookings fall back to the field.
        // checkedInBy (2026-10-27, Field Staff Logins) records who did the
        // check-in and must be the caller. Optional for the owner/host so a
        // cached older owners-app build (which doesn't send it) keeps
        // working; required for staff. Staff: field events only, within the
        // event-day window (see canStaffCheckIn at the top).
        allow update: if request.auth != null
          && (
            ((resource.data.get('hostOwnerId', null) == request.auth.uid
              || (resource.data.get('hostOwnerId', null) == null
                && get(/databases/$(database)/documents/fields/$(resource.data.fieldId)).data.ownerId == request.auth.uid))
              && (!("checkedInBy" in request.resource.data.diff(resource.data).affectedKeys())
                || request.resource.data.checkedInBy == request.auth.uid))
            ||
            (resource.data.get('hostOwnerId', null) == null
              && canStaffCheckIn(resource.data.get('fieldId', null), eventId)
              && request.resource.data.get('checkedInBy', null) == request.auth.uid
              && "checkedInBy" in request.resource.data.diff(resource.data).affectedKeys())
          )
          // checkInMethod ("qr" | "name") added 2026-10-22; "code" check-ins
          // are written server-side by checkInByCode.
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["checkedIn", "checkedInAt", "checkInMethod", "checkedInBy"])
          && (!("checkInMethod" in request.resource.data) || request.resource.data.checkInMethod in ["qr", "name"]);

        // Private per-attendee details for a booking (legal name, DOB,
        // guardian name/phone snapshots). The booking doc itself is
        // publicly readable (rule above), so none of this can live on it —
        // it lives here instead, readable only by the booking's own player
        // (the parent) and the owner of the field the booking is for.
        // Written only by Cloud Functions (Admin SDK bypasses rules). The
        // parent may delete them, but only alongside a self-cancel of a
        // free booking (same not-paid gate as deleting the booking itself).
        match /attendeeDetails/{attId} {
          allow read: if request.auth != null && (
            request.auth.uid == uid
            || get(/databases/$(database)/documents/events/$(eventId)/bookings/$(uid)).data.get('hostOwnerId', null) == request.auth.uid
            || get(/databases/$(database)/documents/fields/$(get(/databases/$(database)/documents/events/$(eventId)/bookings/$(uid)).data.fieldId)).data.ownerId == request.auth.uid
            // Field staff, event-day window only (2026-10-27).
            || (get(/databases/$(database)/documents/events/$(eventId)/bookings/$(uid)).data.get('hostOwnerId', null) == null
              && canStaffCheckIn(get(/databases/$(database)/documents/events/$(eventId)/bookings/$(uid)).data.get('fieldId', null), eventId))
          );
          allow create, update: if false;
          allow delete: if request.auth != null && request.auth.uid == uid
            && get(/databases/$(database)/documents/events/$(eventId)/bookings/$(uid)).data.get('paid', false) != true;
        }
      }

      // The real, per-event "who's interested" list — same pattern as
      // bookings, so both can be shown together in one segmented list
      // (Booked, then Interested). Public read, self-only add/remove, no
      // update — favoriting is just "does this doc exist," same idiom as
      // the favorites collection itself.
      match /interested/{uid} {
        allow read: if true;
        allow create: if request.auth != null && request.auth.uid == uid && request.resource.data.uid == uid;
        allow delete: if request.auth != null && request.auth.uid == uid;
        allow update: if false;
      }
    }
    // A field owner's own account — separate from the player users/{uid}
    // collection entirely, even if the same person signs into both apps
    // with the same email. Self-owned, same pattern as everything else.
    //
    match /owners/{ownerId} {
      allow read: if request.auth != null && (request.auth.uid == ownerId || isAdmin());
      // Security fix 2026-10-13: create used to accept any keys, so an
      // owner doc could be born with payoutsEnabled/stripeConnectAccountId
      // /feeModel already set — exactly the fields createBookingCheckout
      // trusts and the update rule below protects. The app only ever creates
      // this doc with email/name/createdAt (plus acceptedTerms*/name via a
      // merge set), so those protected keys are simply refused on create.
      allow create: if request.auth != null && request.auth.uid == ownerId
        && !request.resource.data.keys().hasAny([
          "stripeConnectAccountId", "payoutsEnabled", "chargesEnabled",
          "connectOnboardingComplete", "feeModel", "claimedFieldCount"
        ]);
      // Still client-deletable: the owner app's deleteAccount() removes this
      // doc itself. Known leftover: delete + recreate lets an owner pick
      // feeModel again. It only changes who pays Atlas's fee, not the fee.
      // Closing it fully means moving account deletion into a Cloud Function.
      allow delete: if request.auth != null && request.auth.uid == ownerId;
      // Subscription and billing fields are readable (so the owner app can
      // show real status) but never writable by the owner's own client —
      // only Cloud Functions, via the admin SDK, can set these, after
      // actually verifying something with Stripe. Without this, the
      // existing self-write rule would let anyone set their own account to
      // "active" directly from browser devtools, no payment required.
      allow update: if request.auth != null && (
        (request.auth.uid == ownerId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            "stripeConnectAccountId", "payoutsEnabled", "chargesEnabled",
            "connectOnboardingComplete"
          ])
          // claimedFieldCount is a denormalized counter (no cap enforced on
          // it anymore, but still kept honest for admin-portal visibility)
          // — the client increments its own copy in the same batch as a
          // field claim (there's no Cloud Function on that path), so this
          // can't just be added to the fully-blocked list above. It can
          // only ever go up, by exactly 1, one claim at a time.
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["claimedFieldCount"])
            || request.resource.data.claimedFieldCount == resource.data.get('claimedFieldCount', 0) + 1)
          // feeModel ("pass_to_player" or "absorb") is chosen once, right
          // after an owner's first field claim, and locked in for good —
          // matches Atlas Standard's "selected at sign-up" design. Once
          // set, no further OWNER client write may touch it at all; a
          // real fee-model change goes through the isAdmin() branch below
          // instead.
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["feeModel"])
            || !("feeModel" in resource.data)))
        ||
        // Admin can change a field's fee model directly from the admin
        // portal (2026-09-30) — the one thing deliberately locked out of
        // owner self-service above. A real fee-model change was already a
        // rare, manually-handled case (previously Firebase console/
        // Discord); this just gives it a real UI instead of hand-editing
        // Firestore. Scoped to ONLY this key so the grant can never be
        // used to touch payouts/Stripe fields or anything else here.
        (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["feeModel"]))
      );
    }
    // A signed-in user can read and write ONLY their own profile document —
    // never anyone else's, and never before they're authenticated. This is
    // still where actual PII lives (email, phone, first/last name) — the
    // publicProfiles collection below is the deliberately narrow, public-
    // facing mirror used for viewing other players.
    match /users/{userId} {
      // Split from a single read+write line (2026-09-28) so the admin
      // read grant below can't accidentally also grant admin write —
      // the admin portal's new Players section needs to show a player's
      // email, but should never be able to edit their account. Write
      // stays self-only, unchanged.
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      // A player can write their own doc freely, with one narrow carve-out:
      // "verified" can only ever be set to true when the Auth ID token's own
      // email_verified claim says so — otherwise a player could just set
      // the trust badge on themselves from devtools with no real
      // verification at all. Doesn't block unsetting it (not a real case
      // here); request.resource.data reflects the full resulting document
      // regardless of merge vs. full-set, so this holds either way.
      // 2026-10-06: .get('verified', false) below, not .verified. A new users doc has no
      // verified field, and reading a missing field errors (= deny) instead of
      // returning null, so every unverified-email player's writes, including the
      // first create and the terms acceptance, were being rejected.
      allow write: if request.auth != null && request.auth.uid == userId
        && (request.resource.data.get('verified', false) != true || request.auth.token.email_verified == true);

      // A player's own mirror of their bookings — self-access covers
      // create/delete (booking/canceling) via the parent rule above. This
      // adds one narrow exception: the event's own field owner can also
      // mark checkedIn/checkedInAt here, restricted to just those two
      // fields. Necessary, not optional — the achievement engine and the
      // player's own Schedule tab both read from this copy, not the
      // event-side one the scanner naturally writes to, so without this
      // a real check-in would silently never be visible here at all.
      match /bookings/{eventId} {
        // This mirror doc used to inherit a create rule of its own (a
        // match block on a parent document doesn't cascade to
        // subcollections, so it always needed one explicitly) — now
        // locked down the same way as the event-side booking above and
        // for the same reason: booking creation, paid or free, is
        // Cloud-Function-only, so both copies of a booking are always
        // written together by the same trusted process instead of two
        // separate client writes that could drift apart.
        allow create: if false;

        // Deletion (canceling) blocked for a paid booking — same real
        // backstop as the event-side mirror above. A client-side check
        // alone could be bypassed; this is enforced regardless of what
        // code actually calls it. Losing this delete rule entirely was a
        // real regression once already — it got dropped when the
        // update/read exceptions below were added, since only what those
        // two needed was written, not what already existed. Worth being
        // careful not to repeat that here.
        allow delete: if request.auth != null && request.auth.uid == userId
          // .get() with a default, not a bare field access — a free
          // booking never had `paid` written at all (bookFreeEvent
          // omits it entirely rather than writing paid: false), and
          // reading a field that doesn't exist via dot notation is a
          // rules-evaluation error here, not a null — which silently
          // denies the whole allow expression. That's what was
          // breaking self-cancel for every free-event booking: the
          // uid/ownership check was fine, this line just errored out
          // before it ever got evaluated.
          && resource.data.get('paid', false) != true
          // Games carried over from a child profile at graduation
          // (claimChildProfile, 2026-10-27) carry no `paid`, so without this
          // the cancel path above would let a stray tap erase history.
          && resource.data.get('inherited', false) != true;

        // hostOwnerId (Atlas Major) is denormalized onto the booking by the
        // Cloud Function that creates it (client create is blocked above), so
        // it can be trusted here; field-based bookings fall back to the field.
        // checkedInBy (2026-10-27, Field Staff Logins) records who did the
        // check-in and must be the caller. Optional for the owner/host so a
        // cached older owners-app build (which doesn't send it) keeps
        // working; required for staff. Staff: field events only, within the
        // event-day window (see canStaffCheckIn at the top).
        allow update: if request.auth != null
          && (
            ((resource.data.get('hostOwnerId', null) == request.auth.uid
              || (resource.data.get('hostOwnerId', null) == null
                && get(/databases/$(database)/documents/fields/$(resource.data.fieldId)).data.ownerId == request.auth.uid))
              && (!("checkedInBy" in request.resource.data.diff(resource.data).affectedKeys())
                || request.resource.data.checkedInBy == request.auth.uid))
            ||
            (resource.data.get('hostOwnerId', null) == null
              && canStaffCheckIn(resource.data.get('fieldId', null), eventId)
              && request.resource.data.get('checkedInBy', null) == request.auth.uid
              && "checkedInBy" in request.resource.data.diff(resource.data).affectedKeys())
          )
          // checkInMethod ("qr" | "name") added 2026-10-22; "code" check-ins
          // are written server-side by checkInByCode.
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["checkedIn", "checkedInAt", "checkInMethod", "checkedInBy"])
          && (!("checkInMethod" in request.resource.data) || request.resource.data.checkInMethod in ["qr", "name"]);

        // Real bookings are a real commitment ("I will physically be at
        // this place, on this date") — a meaningfully stronger signal
        // than a favorite, and public visibility of that carries a real
        // physical-safety risk (anyone, not just people the player knows,
        // could look up exactly where and when to find them). Friends-only
        // read is the deliberate middle ground: the social-proof value
        // ("yeah, they're locked in for Saturday") without exposing a
        // specific person's future whereabouts to total strangers.
        // Checks both possible orderings of the deterministic
        // friendRequests id, since either person could have sent the
        // original request.
        allow read: if request.auth != null && (
          request.auth.uid == userId
          || (
            exists(/databases/$(database)/documents/friendRequests/$(request.auth.uid + '_' + userId))
            && get(/databases/$(database)/documents/friendRequests/$(request.auth.uid + '_' + userId)).data.status == "accepted"
          )
          || (
            exists(/databases/$(database)/documents/friendRequests/$(userId + '_' + request.auth.uid))
            && get(/databases/$(database)/documents/friendRequests/$(userId + '_' + request.auth.uid)).data.status == "accepted"
          )
        );
      }

      // Child profiles — NOT accounts: no auth identity, no login, just a
      // record the parent keeps for booking a minor into an event. Parent
      // only, nobody else ever reads this collection (field owners see a
      // snapshot taken at booking time, under the booking's attendeeDetails,
      // never this live profile). dob is permanent once created — an update
      // can't change it, so a guardian can't edit a child's age to get past
      // a field's minimum age; corrections go through support. avatar is a
      // preset id string, never an uploaded photo.
      match /dependents/{depId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['fullName', 'callsign', 'dob', 'avatar', 'createdAt'])
          && request.resource.data.keys().hasAll(['fullName', 'callsign', 'dob', 'avatar', 'createdAt'])
          && request.resource.data.fullName is string && request.resource.data.fullName.size() > 0 && request.resource.data.fullName.size() <= 80
          && request.resource.data.callsign is string && request.resource.data.callsign.size() > 0 && request.resource.data.callsign.size() <= 40
          && request.resource.data.dob is string && request.resource.data.dob.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.avatar is string && request.resource.data.avatar.size() <= 40
          && request.resource.data.createdAt == request.time;
        allow update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['fullName', 'callsign', 'dob', 'avatar', 'createdAt'])
          && request.resource.data.dob == resource.data.dob
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.fullName is string && request.resource.data.fullName.size() > 0 && request.resource.data.fullName.size() <= 80
          && request.resource.data.callsign is string && request.resource.data.callsign.size() > 0 && request.resource.data.callsign.size() <= 40
          && request.resource.data.avatar is string && request.resource.data.avatar.size() <= 40;
        allow delete: if request.auth != null && request.auth.uid == userId;

        // Child Patches (2026-10-27). Deliberately NOT named "patches": the
        // {path=**}/patches collection-group rule below is public read, and
        // a child's patches are private to the parent. The parent's own app
        // grants them (same self-heal trust model as an adult's own
        // users/{uid}/patches) and marks them seen. A field owner may create
        // (never update/delete) one of their field's patches for a child who
        // was checked in there. get (not list) is open to any signed-in user
        // so the owner app can show who already holds a patch; the path needs
        // the parent uid AND the private dependent id, which only the parent
        // and fields that child was booked at ever see. Graduation copies and
        // deletes these server-side (claimChildProfile).
        match /childPatches/{patchId} {
          allow get: if request.auth != null;
          allow list: if request.auth != null && request.auth.uid == userId;
          allow create, update, delete: if request.auth != null && request.auth.uid == userId;
          allow create: if request.auth != null && 'fieldId' in request.resource.data
            && fieldOwnerChildGrant(userId, depId, patchId);
        }
      }

      // Pending/finished hand-over of a child profile to the child's own
      // account, one doc per dependent. Written only by the
      // startChildGraduation / cancelChildGraduation / claimChildProfile
      // functions; the parent reads it to show "Invite sent to …".
      match /childGraduations/{depId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // Loosened to public read — favorited events/fields carry no PII,
      // and being viewable is the whole point once other players can look
      // at a profile (their Interested/Past events). Write stays owner-only.
      match /favorites/{favoriteId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Same reasoning as favorites — patches are meant to be shown off,
      // not private. Write stays owner-only.
      match /patches/{patchId} {
        allow read: if true;
        // isAdmin() added 2026-09-28 so a catalog patch (achievementPatches
        // entries with trigger: null — Bug Hunter, Ambassador, Secret
        // Agent, etc. — need a human, not a rule, to grant them) can be
        // granted from the admin portal's Players section instead of by
        // hand through the Firebase console.
        allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
        // 2026-10-27: a field owner (one of their field's patches, to a player
        // checked in there) or a team officer (a team-library patch, to a
        // current member) may create — never update or delete — a patch in
        // someone else's collection. Both pinned to the library entry.
        // Each path is guarded on its own key so the other path's lookups
        // (which assume that key) never run and error out.
        allow create: if request.auth != null && (
          ('fieldId' in request.resource.data && fieldOwnerGrant(userId, patchId))
          || ('teamId' in request.resource.data && teamOfficerGrant(userId, patchId))
        );
      }

      // Digital vouchers issued when an owner cancels an event a player
      // already paid to attend — see cancelEventWithVouchers. Same trust
      // model as owners/{ownerId}'s Stripe-derived fields: only ever
      // written by a Cloud Function via the Admin SDK (issued at
      // cancellation, decremented/redeemed at booking via
      // bookEventWithVoucher), never directly by a client, since a
      // client-writable balance here would be real, spendable money.
      match /vouchers/{voucherId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow write: if false;
      }

      // In-app notices — currently just "an event you reserved was
      // canceled," with a voucher amount if one was issued. Same
      // Cloud-Function-only create as vouchers above, since these are
      // written to another user's subcollection (the canceling owner
      // isn't the notice's own recipient) and a client can't safely be
      // trusted to write into someone else's data. The one thing the
      // recipient CAN do themselves is dismiss it, narrowed to just the
      // acknowledged field — same single-field self-update idiom already
      // used for owners/{ownerId} and event bookings' checkedIn.
      match /cancellationNotices/{noticeId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, delete: if false;
        allow update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["acknowledged"]);
      }
    }

    // Collection-group read for the admin portal's "patches received"
    // stat. Confirmed by testing (2026-09-06) that the nested rule right
    // above this one — users/{userId}/patches/{patchId}, allow read: true
    // — does NOT cover a collectionGroup("patches") query; Firestore only
    // grants collection-group access through a rule declared with this
    // {path=**} wildcard form, regardless of whether an existing nested
    // rule's path pattern would technically match the same documents.
    // Same public-read policy as the nested rule, just in the form
    // collection-group queries actually require. Safe to declare broadly
    // like this because "patches" only ever exists at users/{uid}/patches
    // — no other subcollection anywhere in this schema shares that name.
    match /{path=**}/patches/{patchId} {
      allow read: if true;
    }

    // Collection-group reads for the admin portal's #patches page
    // (2026-10-27) — same public read as the nested library rules; this
    // {path=**} form is what collection-group queries require.
    match /{path=**}/fieldPatches/{patchId} {
      allow read: if true;
    }
    match /{path=**}/teamPatches/{libId} {
      allow read: if true;
    }

    // Multiple teams per player (2026-10-25, Brandon/Heretic feedback). The
    // team's members subcollection is the source of truth for which teams a
    // player is on; the app finds them with a collectionGroup("members")
    // query on uid. Same public read as the nested teams/{teamId}/members
    // rule — this form is the only one collection-group queries honor (see
    // the patches note above). "members" only ever exists under teams/.
    // Needs the collection-group uid index in firestore.indexes.json.
    match /{path=**}/members/{memberUid} {
      allow read: if true;
    }

    // Field Staff Logins (2026-10-27): a staff member finds their own grants
    // with a collectionGroup("staff") where uid == me query. "staff" only
    // ever exists under fields/. Needs the collection-group uid index in
    // firestore.indexes.json.
    match /{path=**}/staff/{staffUid} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // In-app "Send feedback" from the Profile page (2026-10-25). Written only
    // by the submitPlayerFeedback Cloud Function (Admin SDK), which also
    // emails it to Michael. Clients never write; only the admin reads.
    match /playerFeedback/{feedbackId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // The public-facing mirror of a player's profile — deliberately narrow.
    // Only ever contains callsign, avatarUrl, featuredPatch, teamId/Name,
    // createdAt, and verified — never email, phone, or real name. Kept in
    // sync by the same client functions that write the corresponding
    // private fields on users/{uid}.
    match /publicProfiles/{uid} {
      allow read: if true;
      allow create, delete: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && (
        // Same verified-forgery carve-out as users/{userId} above — the
        // public mirror is just as self-writable, so it needs the same
        // guard, not just the source doc.
        (request.auth.uid == uid
          && (request.resource.data.get('verified', false) != true || request.auth.token.email_verified == true))
        ||
        // Anyone signing up with this player's referral link can bump
        // their referral count by exactly 1 — narrow, single-field,
        // increment-only. This is the one deliberate exception to
        // "only you can write your own profile," needed because
        // referralCount has to be readable by achievement evaluation,
        // and only the referrer's own profile is a safe place to keep it.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["referralCount"])
          && request.resource.data.referralCount == resource.data.get('referralCount', 0) + 1)
      );
    }

    // Friend requests. A top-level collection (not a subcollection under
    // either user) because a friendship spans two accounts, and neither
    // account's own rules should let it write into the other's data — this
    // lets each side write only the field their own action actually
    // controls. Doc id convention: "{fromUid}_{toUid}".
    match /friendRequests/{requestId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
      // Security fix 2026-10-13: requestId and toUid used to be free, so a
      // player could file a request at {self}_{victim} addressed to
      // themselves, "accept" it, and pass the friend check on
      // users/{victim}/bookings. The id now has to be {fromUid}_{toUid}
      // (what useFriends.js already uses) and you can't friend yourself.
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.fromUid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && requestId == request.auth.uid + '_' + request.resource.data.toUid
        && request.resource.data.status == "pending";
      // Only the recipient can accept — and only the status field changes.
      allow update: if request.auth != null
        && request.auth.uid == resource.data.toUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
        && request.resource.data.status == "accepted";
      // Either side can remove it — the sender cancelling a pending
      // request, the recipient declining one, or either side unfriending
      // later (deleting an accepted request just ends the friendship).
      allow delete: if request.auth != null && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
    }

    // Waiver signatures: a signed-in user can create and read only their
    // OWN signature (never anyone else's), and can never edit or delete one
    // once created — a signed waiver is a permanent record, not something
    // that should be alterable after the fact. The document id itself
    // (uid_eventId) enforces "one signature per event per player." A field
    // owner can also read signatures tied to their own field's events —
    // that's the whole point of the waiver existing, so they can actually
    // see who's signed before letting them play.
    // Booking check-in codes (2026-10-22). Never on the booking doc (public)
    // or the player's mirror (friends can read it). Only the player and the
    // admin can read a code; Cloud Functions write them (Admin SDK).
    match /bookingCodes/{codeId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.uid || isAdmin());
      allow write: if false;
    }
    // Code -> booking lookup, used only by the checkInByCode function.
    match /bookingCodeIndex/{indexId} {
      allow read, write: if false;
    }

    match /waiverSignatures/{sigId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.uid
        || resource.data.get('hostOwnerId', null) == request.auth.uid
        // Guarded so a Major's signature (fieldId null) short-circuits to false
        // here instead of erroring on fields/$(null).
        || (resource.data.get('fieldId', null) != null
          && get(/databases/$(database)/documents/fields/$(resource.data.fieldId)).data.ownerId == request.auth.uid)
        // Field staff, event-day window only (2026-10-27).
        || (resource.data.get('fieldId', null) != null
          && resource.data.get('hostOwnerId', null) == null
          && canStaffCheckIn(resource.data.fieldId, resource.data.get('eventId', '')))
      );
      // Child waiver docs (guardian signing on behalf of a minor) reuse this
      // exact pattern: one immutable doc per child per event, id
      // uid_eventId_dependentId, created by the guardian in the same action
      // as their own signature. A doc carrying a dependentId must have the
      // matching id AND the dependent must exist under the signer's own
      // users/{uid}/dependents — so a guardian can't sign for a child
      // profile that isn't theirs. The booking Cloud Functions re-verify
      // that every attendee has a signature doc before charging anything.
      //
      // Child-only bookings (2026-10-21): when the parent isn't playing, one
      // more immutable doc per child, id uid_eventId_dependentId_absent with
      // guardianAbsent: true, records that they agreed to the "you are not
      // playing" section of the guardian notice. Same ownership check.
      //
      // The guardian's own doc (no dependentId) must sit at exactly
      // uid_eventId — before 2026-10-21 any id was accepted, which would have
      // let someone create victimUid_eventId (with their own uid inside) and
      // satisfy the booking functions' exists() check for another player.
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid
        && (
          (
            !('dependentId' in request.resource.data)
            && !('guardianAbsent' in request.resource.data)
            && sigId == request.resource.data.uid + '_' + request.resource.data.eventId
          )
          || (
            !('guardianAbsent' in request.resource.data)
            && sigId == request.resource.data.uid + '_' + request.resource.data.eventId + '_' + request.resource.data.dependentId
            && exists(/databases/$(database)/documents/users/$(request.auth.uid)/dependents/$(request.resource.data.dependentId))
          )
          || (
            request.resource.data.guardianAbsent == true
            && sigId == request.resource.data.uid + '_' + request.resource.data.eventId + '_' + request.resource.data.dependentId + '_absent'
            && exists(/databases/$(database)/documents/users/$(request.auth.uid)/dependents/$(request.resource.data.dependentId))
          )
        );
      allow update, delete: if false;
    }

    // Teams (clans). Public read — rosters, patches, and names are meant to
    // be visible to everyone, not just members. Any signed-in user can
    // create a team (they become its founding officer in the same batched
    // write as the member doc below). Editing team info requires being an
    // officer of THAT team, checked via a nested lookup into its own
    // members subcollection.
    match /teams/{teamId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
        && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == "officer";
      allow delete: if false; // no team deletion in v1 — avoid an officer accidentally wiping a real clan's history

      match /members/{memberUid} {
        allow read: if true;
        allow create: if request.auth != null && (
          // Open joining — anyone signed in can join as a regular member,
          // matching how real airsoft clans actually work (no gatekeeping).
          (memberUid == request.auth.uid && request.resource.data.role == "member"
            // Team Join Approval (2026-10-06): self-join only on OPEN teams.
            // Without this, anyone could write their own member doc directly
            // and bypass approval. .get() with a default, not .joinPolicy:
            // existing teams have no such field and a bare read of a missing
            // field errors (= deny). Absent = open, so existing teams are
            // unchanged. Approval teams are joined via an officer creating
            // the member doc (the officer clause below).
            && get(/databases/$(database)/documents/teams/$(teamId)).data.get('joinPolicy', 'open') == 'open')
          ||
          // Founding officer — only the team's own creator, only for their
          // own uid, only at the moment the team itself is created (checked
          // via createdBy on the parent team doc). Real bug, found
          // 2026-09-21 via a live "permission-denied" report on team
          // creation: createTeam() creates the team doc AND this founding
          // member doc in the SAME writeBatch, but plain get() only ever
          // sees the database state from BEFORE the batch's own writes are
          // applied — so it could never see the team doc this same batch
          // was in the middle of creating, and this clause could never
          // actually pass for anyone. getAfter() is the function Firestore
          // provides specifically for this — it reads a document's state
          // once every write already staged in this same transaction/batch
          // has been applied, but before the batch commits.
          (memberUid == request.auth.uid && request.resource.data.role == "officer"
            && getAfter(/databases/$(database)/documents/teams/$(teamId)).data.createdBy == request.auth.uid)
          ||
          // An existing officer adding/promoting someone.
          (exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid))
            && get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == "officer")
        );
        allow update: if request.auth != null
          && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid))
          && get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == "officer";
        allow delete: if request.auth != null && (
          memberUid == request.auth.uid // leaving on your own
          || (exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid))
              && get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == "officer") // an officer removing someone
        );
      }

      // Team patch library (2026-10-27). Public read. Officers add their own
      // uploads (grantDocId pinned to a team-namespaced id, catalogId null)
      // and can remove entries; nobody edits an entry after creation
      // (delete + re-add), so it never drifts from copies already granted.
      // Catalog-linked entries (DTB, WhiteHorse, ...) are created only by the
      // Admin SDK seed script.
      match /teamPatches/{libId} {
        allow read: if true;
        allow create: if isTeamOfficerOf(teamId)
          && request.resource.data.keys().hasOnly(['name', 'imageUrl', 'details', 'grantDocId', 'catalogId', 'createdBy', 'createdAt'])
          && validPatchArt(request.resource.data)
          && request.resource.data.grantDocId == 'team-' + teamId + '-' + libId
          && request.resource.data.get('catalogId', null) == null
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if false;
        allow delete: if isTeamOfficerOf(teamId) || isAdmin();
      }

      // Team event calendar (WhiteHorse Milsim request, 2026-10-06). Events
      // here are the team's own "we're attending this" posts — external
      // ticket link, no Atlas booking — so they deliberately live apart from
      // the bookable top-level events collection. Public read (the public
      // calendar), officer-only write, same officer check as the team doc.
      match /events/{eventId} {
        allow read: if true;
        allow create: if request.auth != null
          && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid))
          && get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == "officer"
          && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if request.auth != null
          && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid))
          && get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == "officer";

        // Per-event attendance. Team members can mark going / interested /
        // notGoing and can read the whole list; a non-member can only mark
        // themselves "interested" and can only read their own doc.
        match /rsvps/{uid} {
          allow read: if request.auth != null && (
            request.auth.uid == uid
            || exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid))
          );
          allow create, update: if request.auth != null
            && request.auth.uid == uid
            && request.resource.data.uid == uid
            && (
              (exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid))
                && request.resource.data.status in ["going", "interested", "notGoing"])
              || request.resource.data.status == "interested"
            );
          allow delete: if request.auth != null && request.auth.uid == uid;
        }
      }

      // Custom team roles — labels only (title + description), no
      // permissions. Public read; officer-only create/edit/delete. Which
      // members hold which roles lives on the member doc (roleIds), which is
      // already officer-only to update.
      match /roles/{roleId} {
        allow read: if true;
        allow create, update, delete: if request.auth != null
          && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid))
          && get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == "officer";
      }

      // Team ranks (2026-10-06) — officer-defined, military-style ladder: a
      // title, optional insignia image, and the requirements to earn it.
      // Public read so anyone can see which ranks exist. Labels only, no
      // permissions. Which member holds which rank lives on the member doc
      // (rankId), already officer-only to update.
      match /ranks/{rankId} {
        allow read: if true;
        allow create, update, delete: if request.auth != null
          && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid))
          && get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == "officer";
      }
    }

    // Officer role requests — a member asking their team's officers to
    // promote them, and any officer approving or denying that ask. One
    // doc per (team, requesting member) pair; existence of the doc IS
    // "pending" — no status field, no denial record kept, same
    // "decline = delete" idiom friendRequests already uses above. The
    // predictable {teamId}_{uid} doc id is what stops a member from
    // stacking up multiple pending requests for the same team: a second
    // attempt while one's already pending hits an existing document,
    // which Firestore rules evaluate as an update (not a create) — and
    // update is hard-denied below.
    match /officerRequests/{requestId} {
      // Bug fixed 2026-10-04: a read of a doc that doesn't exist yet has
      // resource == null, so resource.data.uid errored and the rule denied
      // it. useMyOfficerRequest's onSnapshot on {teamId}_{uid} hits exactly
      // that case before any request exists, so the listener died with
      // permission-denied, the button never flipped to "Pending", and a
      // second tap became a denied update ("try again"). A missing doc is
      // now readable only at the caller's own {teamId}_{uid} id.
      allow read: if request.auth != null && (
        resource == null
          ? requestId.matches('.*_' + request.auth.uid)
          : (request.auth.uid == resource.data.uid
             || (exists(/databases/$(database)/documents/teams/$(resource.data.teamId)/members/$(request.auth.uid))
                 && get(/databases/$(database)/documents/teams/$(resource.data.teamId)/members/$(request.auth.uid)).data.role == "officer"))
      );
      // Only a genuine current member (not already an officer) can
      // request for themselves, and only under the doc id this team/uid
      // pair is supposed to use — keeps the id predictable for the
      // "already pending" check above, and lets approve/deny address the
      // doc directly with no query needed.
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid
        && requestId == request.resource.data.teamId + '_' + request.resource.data.uid
        && exists(/databases/$(database)/documents/teams/$(request.resource.data.teamId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)/members/$(request.auth.uid)).data.role == "member";
      allow update: if false; // no in-place edits — approve is a batch (role flip elsewhere + delete here), deny is just a delete
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.uid // the requester cancelling their own ask
        || (exists(/databases/$(database)/documents/teams/$(resource.data.teamId)/members/$(request.auth.uid))
            && get(/databases/$(database)/documents/teams/$(resource.data.teamId)/members/$(request.auth.uid)).data.role == "officer") // an officer denying, or approving (paired with the role-change write)
      );
    }

    // Team join requests (2026-10-06) — a player asking to join a team whose
    // joinPolicy is "approval", and any officer approving or denying. Same
    // shape as officerRequests above: one doc per (team, player) at
    // {teamId}_{uid}, existence = pending, deny = delete. One difference:
    // approving does NOT delete the doc. An officer can't write the player's
    // own users/publicProfiles docs, so approval creates the member doc and
    // marks this request approved:true; the player's own app sees that,
    // finishes their profile (teamId/teamName) and deletes the request.
    match /joinRequests/{requestId} {
      // Same missing-doc handling as officerRequests (resource == null on a
      // doc that doesn't exist yet), plus the player's own-uid query.
      allow read: if request.auth != null && (
        resource == null
          ? requestId.matches('.*_' + request.auth.uid)
          : (request.auth.uid == resource.data.uid
             || (exists(/databases/$(database)/documents/teams/$(resource.data.teamId)/members/$(request.auth.uid))
                 && get(/databases/$(database)/documents/teams/$(resource.data.teamId)/members/$(request.auth.uid)).data.role == "officer"))
      );
      // Only for yourself, under your own {teamId}_{uid} id, only on a team
      // that actually requires approval, and only if you're not already in
      // it. A second request while one is pending hits an existing doc,
      // which is an update, and the only update allowed is an officer's.
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid
        && requestId == request.resource.data.teamId + '_' + request.resource.data.uid
        && get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.get('joinPolicy', 'open') == 'approval'
        && !exists(/databases/$(database)/documents/teams/$(request.resource.data.teamId)/members/$(request.auth.uid))
        && request.resource.data.get('approved', false) == false;
      // Officer approving: the one allowed edit, flipping approved to true.
      allow update: if request.auth != null
        && exists(/databases/$(database)/documents/teams/$(resource.data.teamId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/teams/$(resource.data.teamId)/members/$(request.auth.uid)).data.role == "officer"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["approved"])
        && request.resource.data.approved == true;
      // The player cancelling or finishing, or an officer denying.
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.uid
        || (exists(/databases/$(database)/documents/teams/$(resource.data.teamId)/members/$(request.auth.uid))
            && get(/databases/$(database)/documents/teams/$(resource.data.teamId)/members/$(request.auth.uid)).data.role == "officer")
      );
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /fields/{fieldId} {
      allow read: if true;
      allow write: if false; // only the seed/sync script (firebase-admin) can write
    }
    match /events/{eventId} {
      allow read: if true;
      allow write: if false;
    }
    // A signed-in user can read and write ONLY their own profile document —
    // never anyone else's, and never before they're authenticated.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}

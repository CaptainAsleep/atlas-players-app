rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{userId}/{fileName} {
      // Avatars are publicly viewable (same as any social app profile photo)
      // but only the owning user can upload/replace/delete their own.
      // Split from create/update because request.resource (and therefore
      // its size/contentType) doesn't exist on a delete request — folding
      // delete into the same "write" rule as the size/type checks would
      // silently deny every deletion, since those checks error out on null.
      allow read: if true;
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Child profile photos (2026-10-28). Uploaded only by the setChildAvatar
    // Cloud Function under a random file name, so the public URL never
    // carries the parent's uid or the child's private profile id (an
    // avatars/{uid}/... path would put the family link in every image URL).
    match /childAvatars/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /patches/{userId}/{fileName} {
      // Same rule shape as avatars — public read (a featured patch needs to
      // be visible next to a callsign), owner-only write.
      allow read: if true;
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /teamPatches/{teamId}/{fileName} {
      // Public read like everything else team-related, but only an officer
      // of THAT specific team can upload/replace/delete its patch — checked
      // by reading Firestore's own officer record for this team, so the
      // permission model stays in one place rather than duplicated logic.
      allow read: if true;
      allow delete: if request.auth != null
                   && firestore.get(/databases/(default)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == "officer";
      allow create, update: if request.auth != null
                   && firestore.get(/databases/(default)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == "officer"
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Owner-built field patch art (2026-10-27), fieldPatches/{fieldId}/{patchId}.png.
    // Public read; only the field's own owner can upload — same
    // Firestore-lookup ownership check the field's Firestore rules use.
    match /fieldPatches/{fieldId}/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
                   && firestore.get(/databases/(default)/documents/fields/$(fieldId)).data.get('ownerId', null) == request.auth.uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    // Team calendar event banners — same officer-only model as teamPatches.
    match /teamEventBanners/{teamId}/{eventId}/{fileName} {
      allow read: if true;
      allow delete: if request.auth != null
                   && firestore.get(/databases/(default)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == "officer";
      allow create, update: if request.auth != null
                   && firestore.get(/databases/(default)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == "officer"
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Team rank insignia — same officer-only model as teamEventBanners.
    match /teamRanks/{teamId}/{rankId}/{fileName} {
      allow read: if true;
      allow delete: if request.auth != null
                   && firestore.get(/databases/(default)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == "officer";
      allow create, update: if request.auth != null
                   && firestore.get(/databases/(default)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == "officer"
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /fieldGallery/{fieldId}/{fileName} {
      // Same ownership-via-Firestore-lookup pattern as team patches — only
      // this field's actual owner can add/remove gallery photos.
      allow read: if true;
      allow delete: if request.auth != null
                   && firestore.get(/databases/(default)/documents/fields/$(fieldId)).data.ownerId == request.auth.uid;
      allow create, update: if request.auth != null
                   && firestore.get(/databases/(default)/documents/fields/$(fieldId)).data.ownerId == request.auth.uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /eventBanners/{fieldId}/{eventId}/{fileName} {
      // Storing under the field's own id (not just the event's) means this
      // rule only ever needs one lookup — checking that field's owner —
      // rather than nesting a lookup inside a lookup to first discover
      // which field an event belongs to.
      allow read: if true;
      allow delete: if request.auth != null
                   && firestore.get(/databases/(default)/documents/fields/$(fieldId)).data.ownerId == request.auth.uid;
      allow create, update: if request.auth != null
                   && firestore.get(/databases/(default)/documents/fields/$(fieldId)).data.ownerId == request.auth.uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /eventPatches/{fieldId}/{eventId}/{fileName} {
      // Same ownership pattern as event banners — the check-in reward
      // patch an owner attaches to an event. Granting it to a player isn't
      // wired up yet (needs the QR scanner), but the upload itself is real.
      allow read: if true;
      allow delete: if request.auth != null
                   && firestore.get(/databases/(default)/documents/fields/$(fieldId)).data.ownerId == request.auth.uid;
      allow create, update: if request.auth != null
                   && firestore.get(/databases/(default)/documents/fields/$(fieldId)).data.ownerId == request.auth.uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Atlas Major (2026-10-18): an organizer has no field, so these are keyed
    // on the organizer's own uid. The path segment IS the ownership check —
    // no Firestore lookup needed. Same 5MB / image-only limits as above.
    match /hostEventBanners/{ownerUid}/{eventId}/{fileName} {
      allow read: if true;
      allow delete: if request.auth != null && request.auth.uid == ownerUid;
      allow create, update: if request.auth != null && request.auth.uid == ownerUid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /hostEventPatches/{ownerUid}/{eventId}/{fileName} {
      allow read: if true;
      allow delete: if request.auth != null && request.auth.uid == ownerUid;
      allow create, update: if request.auth != null && request.auth.uid == ownerUid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /achievementPatches/{fileName} {
      // The admin-only achievement catalog's artwork — public read, no
      // client write at all. Uploaded only via the seed script, same
      // pattern as the catalog documents themselves.
      allow read: if true;
      allow write: if false;
    }
  }
}
